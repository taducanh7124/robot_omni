  rspfile = $rspfile_name
  rspfile_content = $flags

rule COMPDB_LINK
  command = G$:\IAR\common\bin\ClangdCompDbLinker.exe -f "$rspfile_name"
  description = Building $out...
  rspfile = $rspfile_name
  rspfile_content = $flags



